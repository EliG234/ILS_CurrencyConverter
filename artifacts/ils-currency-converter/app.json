{
  "expo": {
    "name": "ILS Currency Converter",
    "slug": "ils-currency-converter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ils-currency-converter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ilscurrencyconverter.app"
    },
    "android": {
      "package": "com.ilscurrencyconverter.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ILSRateWidget",
              "label": "ILS Rates",
              "description": "Live US dollar and euro rates in Israeli shekels.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.ilscurrencyconverter.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.ilscurrencyconverter.app",
          "widgets": [
            {
              "name": "ILSRateWidget",
              "displayName": "ILS Rates",
              "description": "Live US dollar and euro rates in Israeli shekels.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
